<rule id="money-in-minor-units" category="functional_correctness">
<source>
- file: docs/checkout-review.md
- file: docs/checkout-review.md
  heading: Dates
- file: docs/checkout-review.md
  phrase: Owned by the checkout team.
- file: docs/checkout-review.md
