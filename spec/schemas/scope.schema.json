{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lore.dev/schemas/v1/scope.schema.json",
  "title": "Lore scope block",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "files": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/glob" } },
    "ignores": { "type": "array", "items": { "$ref": "#/$defs/glob" } }
  },
  "$defs": {
    "glob": {
      "type": "string",
      "minLength": 1,
      "not": { "anyOf": [{ "pattern": "(^|/)\\.\\.(/|$)" }, { "pattern": "^/" }] }
    }
  }
}
