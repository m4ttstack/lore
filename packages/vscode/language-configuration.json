{
  "comments": {
    "blockComment": ["<!--", "-->"]
  },
  "brackets": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"]
  ],
  "autoClosingPairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"", "notIn": ["string"] },
    { "open": "<!--", "close": " -->", "notIn": ["comment", "string"] }
  ],
  "surroundingPairs": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"],
    ["\"", "\""],
    ["'", "'"],
    ["`", "`"],
    ["*", "*"],
    ["_", "_"]
  ],
  "folding": {
    "markers": {
      "start": "^<(?:rule|context|defaults|scope)(?:[ \\t].*)?>[ \\t]*$",
      "end": "^</(?:rule|context|defaults|scope)>[ \\t]*$"
    }
  }
}
