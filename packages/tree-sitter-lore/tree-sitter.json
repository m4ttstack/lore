{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "lore",
      "camelcase": "Lore",
      "title": "Lore",
      "scope": "source.lore",
      "path": ".",
      "file-types": ["lore"],
      "injection-regex": "^lore$",
      "class-name": "TreeSitterLore",
      "highlights": "queries/highlights.scm",
      "injections": "queries/injections.scm"
    }
  ],
  "metadata": {
    "version": "0.0.0",
    "license": "MIT",
    "description": "tree-sitter grammar for Lore files",
    "links": {
      "repository": "https://github.com/m4ttstack/lore"
    }
  },
  "bindings": {
    "c": false,
    "go": false,
    "java": false,
    "node": false,
    "python": false,
    "rust": false,
    "swift": false,
    "zig": false
  }
}
