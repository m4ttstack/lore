        "type": "CHOICE",
        "members": [
          {
            "type": "PATTERN",
            "value": "\"[^\"\\r\\n]*\""
          },
          {
            "type": "PATTERN",
            "value": "[^\\s\"=>]+"
          }
        ]
      }
    },
    "_name": {
      "type": "PATTERN",
      "value": "[A-Za-z][A-Za-z0-9-]*"
    }
